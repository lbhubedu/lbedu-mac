# Banco PostgreSQL (opcional na Vercel; sem ele o site funciona em modo stateless com cookies e snapshot verificado)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Opcional: ativa Kilo Gateway no servidor para o assistente
KILO_API_KEY=
KILO_MODEL=openai/gpt-oss-20b

# Opcional: ativa a API autenticada da Pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai-fast

# Opcional: aumenta a cota de consultas ao GitHub Releases
GITHUB_TOKEN=
